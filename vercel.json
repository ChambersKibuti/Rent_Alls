{
  "installCommand": "npm install --prefix frontend && npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}