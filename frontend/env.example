# URL of your deployed backend (no trailing slash), e.g.:
#   VITE_API_URL=https://rentalls-api.vercel.app
#
# Leave BLANK for local development -- vite.config.js proxies /api/* to
# http://localhost:8787 automatically (run the backend project alongside
# this one). Set it only for production builds, or if you're not using
# the dev proxy.
VITE_API_URL=

# --- Google Sign-In ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID (type: Web application). Must be the SAME value as
# GOOGLE_CLIENT_ID in the backend's .env -- this one is public (it's sent
# to the browser), the backend one is what actually verifies tokens.
# Add both your local dev origin (http://localhost:5173) and your
# production frontend URL to the OAuth client's "Authorized JavaScript
# origins" in Google Cloud Console, or the popup will fail.
# Leave blank to disable Google sign-in (the button just won't render).
VITE_GOOGLE_CLIENT_ID=
